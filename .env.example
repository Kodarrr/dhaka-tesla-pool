# Dhaka Tesla Pool - Environment Configuration Example
# Copy this file to .env or use the defaults provided

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dhaka_tesla_pool
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dhaka_tesla_pool?schema=public"

# ==========================================
# Backend API Configuration
# ==========================================
PORT=8000
JWT_SECRET=super-secret-jwt-key-for-dhaka-tesla-pool
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Frontend Web Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

